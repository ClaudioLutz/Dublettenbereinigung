# Database Configuration for Dedupe Pipeline
# Copy this file to .env and fill in your values

# Required: SQL Server connection
DEDUPE_DB_SERVER=your-sql-server-hostname
DEDUPE_DB_DATABASE=your-database-name

# Optional: SQL Server credentials (leave empty for Windows Authentication)
# DEDUPE_DB_USER=your-username
# DEDUPE_DB_PASSWORD=your-password

# Optional: ODBC Driver configuration
# DEDUPE_DB_DRIVER=ODBC Driver 17 for SQL Server
# DEDUPE_DB_ENCRYPT=true
# DEDUPE_DB_TRUST_SERVER_CERTIFICATE=true

# DeepSeek API Configuration for Pattern Discovery
# Copy this file to .env and fill in your actual API key
# NEVER commit .env to git - it should already be in .gitignore
DEEPSEEK_API_KEY=sk-your-key-here-replace-with-actual-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
