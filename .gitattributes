# Auto detect text files and normalize line endings to LF in repository
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.duckdb binary
*.parquet binary
*.csv binary
*.dat binary
*.bin binary
*.npz binary
